// Prisma schema for Harbor.
// S01: the walking skeleton — Contact, Conversation, Message. A Message stores raw + parsed (identical until
// S03's email parsing splits them). pgvector for RAG (S10) is planned in ADR-0002, added when it arrives.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// S02: tenancy. A workspace is a support team's world; agents belong to it, optionally grouped into teams.
model Workspace {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  agents    Agent[]
  teams     Team[]
  contacts  Contact[]
}

model Agent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  name        String    @default("")
  role        String    @default("agent") // agent | admin
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
}

model Team {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  agents      Agent[]
}

model Contact {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String?
  createdAt     DateTime       @default(now())
  identities    Identity[]
  conversations Conversation[]

  @@index([workspaceId])
}

// One human, many identifiers. Unique per (workspace, type, value): email is NOT a primary key — people
// share, change, and alias them. Resolve-or-create keys on this uniqueness; the merge folds duplicates.
model Identity {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        String // email | messenger | external
  value       String
  verified    Boolean  @default(false) // auto-merge only on verified identifiers (S02 debate)
  createdAt   DateTime @default(now())

  @@unique([workspaceId, type, value])
  @@index([contactId])
}

model Conversation {
  id          String    @id @default(cuid())
  workspaceId String    @default("demo-ws")
  subject     String    @default("(no subject)")
  state       String    @default("open") // open | pending | snoozed | closed
  // S04: soft ownership. assigneeId null = unassigned; the claim is an atomic set-if-null (no double-claim).
  assigneeId  String?
  // S06: routing outputs. A rule can assign to a team (then a strategy picks the agent) and set priority.
  assignedTeamId String?
  priority       String @default("normal") // low | normal | high | urgent
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages    Message[]
  assignments Assignment[]
  aiActions   AIAction[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, state, updatedAt])
  @@index([workspaceId, assigneeId])
}

// Audited assignment history (S04): every claim/assign/reassign is a row — who assigned whom, when.
model Assignment {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assigneeId     String? // null = unassigned (a release)
  assignedById   String? // the agent who performed the assignment (null = system/auto)
  at             DateTime     @default(now())

  @@index([conversationId, at])
}

// ── Help center (S05): public, SEO-facing articles. Harbor's one server-rendered surface. ──
model Category {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  order       Int       @default(0)
  articles    Article[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, order])
}

model Article {
  id          String    @id @default(cuid())
  workspaceId String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug        String
  title       String
  body        String    @default("")
  // S08: structured sections [{heading, body}] (the raw material for structure-aware chunking) + version.
  sections    Json      @default("[]")
  version     Int       @default(1)
  status      String    @default("draft") // draft | published
  chunks      ArticleChunk[]
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

// S08: the chunking pipeline's output — the retrieval unit. pgvector `embedding` is added in S10 (ADR-0002);
// the text + metadata + position land here now so S10 is a fill-in, not a migration.
model ArticleChunk {
  id          String  @id @default(cuid())
  workspaceId String
  articleId   String
  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  text        String
  heading     String  @default("")
  position    Int     @default(0)
  index       Int     @default(0)
  // S10: pgvector realized (ADR-0002 → ADR-0010). The embedding is an Unsupported native `vector` column
  // (written/queried via raw SQL: `ORDER BY embedding <=> $q`). embeddingModel + embeddingDim VERSION it —
  // changing the model orphans every vector, so re-embedding is a data migration (the S10 worker job).
  embedding      Unsupported("vector(96)")?
  embeddingModel String?
  embeddingDim   Int?

  @@index([workspaceId])
  @@index([articleId, index])
}

// S08: search analytics. What people search and DON'T find is the content roadmap.
model SearchQuery {
  id          String   @id @default(cuid())
  workspaceId String
  query       String
  resultCount Int
  at          DateTime @default(now())

  @@index([workspaceId, resultCount, at])
}

// ── Routing engine (S06) ──────────────────────────────────────────────────────────────────────
// A rule's condition/actions are the closed-predicate AST from @harbor/shared, stored as JSON. We store the
// AST, not a query string — there is nothing to eval, and evaluation is the same pure function in prod as in
// tests. `order` is explicit (first-match-wins); the AST is validated against the Zod schema on write.
model RoutingRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String   @default("")
  order       Int      @default(100)
  enabled     Boolean  @default(true)
  condition   Json
  actions     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, order])
}

// Persisted round-robin cursor per (workspace, team) — fairness needs a durable position, not randomness.
model TeamCursor {
  id          String @id @default(cuid())
  workspaceId String
  teamId      String
  cursor      Int    @default(0)

  @@unique([workspaceId, teamId])
}

// ── AI (S11+) ─────────────────────────────────────────────────────────────────────────────────
// Append-only cost ledger (S01 thesis, now persisted): every model call logged with tokens/cost/latency.
// "Why is the AI bill $4k?" is a query over this table, grouped by purpose/model/day.
model LLMCall {
  id           String   @id @default(cuid())
  workspaceId  String   @default("demo-ws")
  model        String
  purpose      String // triage | rag-answer | bot-draft …
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  latencyMs    Int
  at           DateTime @default(now())

  @@index([workspaceId, purpose, at])
}

// An AI suggestion attached to a conversation — NEVER an auto-action. Triage (S11), bot drafts/replies (S12).
// Stores the structured payload, the model's reasoning (agent-visible), confidence, and — when an agent
// corrects it — the correction (which becomes an eval case: the data flywheel).
model AIAction {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type            String // triage | bot_draft | bot_reply
  payload         Json // the structured output (e.g. TriageOutput)
  reasoning       String       @default("")
  confidence      Float        @default(0)
  llmCallId       String?
  correctedPayload Json?       // agent correction → tomorrow's eval case
  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// S14: per-workspace bot autonomy settings (the trust ladder). Absent ⇒ DEFAULT_AUTONOMY (off).
model AutonomySetting {
  workspaceId String   @id
  settings    Json // AutonomySettings from @harbor/shared
  updatedAt   DateTime @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String       @default("inbound") // inbound | outbound | note
  // S07: the email Message-ID (angle-bracketed). Header-based threading matches inbound In-Reply-To/References
  // against these — the correct signal that harvests the S03 subject-only flaw.
  messageId      String?
  // `raw` is the untouched source; `parsed` is the display-ready view. Identical in S01; by S03 `raw` is the
  // full MIME and `parsed` is stripped + threaded. Store the original, derive the view — never mutate raw.
  raw            String
  parsed         String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([messageId])
}

// ── SLAs (S07) ──────────────────────────────────────────────────────────────────────────────────
// An SLA is a promise measured on a business calendar. Policy = the targets; Window = one live clock on one
// conversation. The clock math is the pure @harbor/shared core; these rows are its persistence.
model SLAPolicy {
  id                  String   @id @default(cuid())
  workspaceId         String
  name                String   @default("Default")
  priority            String   @default("normal") // which priority this applies to
  channel             String?  // null = any channel
  firstResponseMins   Int      @default(240) // business-minutes to first response
  resolutionMins      Int      @default(1920)
  createdAt           DateTime @default(now())

  @@index([workspaceId, priority])
}

model SLAWindow {
  id             String    @id @default(cuid())
  conversationId String
  kind           String    @default("first_response") // first_response | resolution
  targetMs       Int
  startedAt      DateTime  @default(now())
  pauses         Json      @default("[]") // [{from, to|null}] — business-time paused (awaiting customer)
  breachedAt     DateTime?
  satisfiedAt    DateTime?

  @@index([conversationId, kind])
}
